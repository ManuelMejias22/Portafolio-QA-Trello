          "name": "Tarjeta-Exitosa-Validando-Posicion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()\r\nconst Titulo_Trajeta = pm.collectionVariables.get(\"Titulo\");\r\npm.test(\"el Titulo de la tarjeta debe ser el contenido de la variable Titulo\", ()=> {\r\n    pm.expect(body.name).to.eql(Titulo_Trajeta)\r\n    });\r\n\r\npm.test(\"el status code debe ser 200 OK\" , ()=> {\r\n    pm.response.to.have.status(200)\r\n});\r\n\r\npm.test(\"Se asigno un valor de posicion inicial valido\", () => {\r\n    pm.expect(body.pos).to.be.a(\"number\");\r\n    pm.expect(body.pos).to.be.above(0);\r\n});\r\n\r\npm.environment.set(\"posicion_tarjeta_1\", body.pos);\r\npm.environment.set(\"Id_tarjeta_1\", body.id);\r\n\r\n"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const nuevonombrerandom = pm.collectionVariables.replaceIn(\"{{$randomFirstName}}\")\r\n\r\npm.collectionVariables.set(\"Titulo\", nuevonombrerandom)  \r\n\r\n"
                ]
              }
            }
          ],
